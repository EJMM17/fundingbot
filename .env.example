# ══════════════════════════════════════════════════════════════════
# .env.example — KuCoin Funding Fee Scalper
#
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a git. El .gitignore debe excluirlo.
# ══════════════════════════════════════════════════════════════════

# ── KuCoin Futures API ────────────────────────────────────────────
# Genera las keys en: KuCoin → Account → API Management → Futures
# Permisos requeridos: Futures (Trade + Read)
# OBLIGATORIO activar IP whitelist en producción.
KUCOIN_API_KEY=your_api_key_here
KUCOIN_SECRET=your_secret_here
KUCOIN_PASSPHRASE=your_passphrase_here   # El passphrase que elegiste al crear la key

# ── Seguridad / modo de ejecución ─────────────────────────────────
# Recomendado: deja DRY_RUN=true hasta validar logs y señales.
# Para operar real, cambia explícitamente a false.
DRY_RUN=true
LEVERAGE=5
MARGIN_MODE=cross
MAX_MARGIN_PER_COIN=150
MAX_TOTAL_MARGIN=500
MAX_OPEN_POSITIONS=5
SHUTDOWN_CLOSE_POSITIONS=false

# ── Notificaciones opcionales ─────────────────────────────────────
WEBHOOK_URL=

# Telegram tracking opcional
# Crea un bot con @BotFather, escribele un mensaje y usa tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_POLL_SECONDS=5
TELEGRAM_STATUS_INTERVAL_SECONDS=300

# Autoaprendizaje conservador
ENABLE_AUTO_LEARNING=true
AUTO_LEARNING_REFRESH_SECONDS=900
AUTO_LEARNING_MIN_TRADES=5
AUTO_LEARNING_MAX_BOOST=0.15
AUTO_LEARNING_MAX_PENALTY=0.40

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
